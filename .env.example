# Server Configuration
SERVER_HOST=localhost
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=video_processing
DB_MAX_CONNECTIONS=25

# Storage Configuration
STORAGE_UPLOAD_DIR=./storage/uploads
STORAGE_PROCESSED_DIR=./storage/processed
STORAGE_THUMBNAIL_DIR=./storage/thumbnails
STORAGE_MAX_FILE_SIZE=524288000

# Processing Configuration
PROCESSING_WORKER_COUNT=4
PROCESSING_MAX_CONCURRENT_JOBS=10
PROCESSING_TEMP_DIR=/tmp/video-processing
PROCESSING_SUPPORTED_FORMATS=mp4,avi,mov,mkv,webm

# FFmpeg Configuration
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
FFMPEG_DEFAULT_CODEC=libx264
FFMPEG_DEFAULT_AUDIO_CODEC=aac

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
